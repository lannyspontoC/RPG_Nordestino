import random
import time

#Classe Heroi tá com o ataque e defesa show de bolaa
class Heroi:
    
#Classe Monstro tá só a carcaça, mas não precisamos de mais nada, só a carcaça mesmo
    def __init__(self, tclasse, vida, defesa, ataque, relM = None):
        self.tclasse = tclasse
        self.vida = vida
        self.defesa = defesa
        self.ataque = ataque
        self.relM = relM

    def atacar(self):
        if self.relM.opc == 'defender':
            dano = self.ataque - self.relM.defesa
            if self.ataque >= self.relM.defesa:
                self.relM.vida -= dano
                self.relM.defesa = 0
            else:
                self.relM.defesa -= self.ataque
                
        else:
            dano = self.ataque - self.relM.ataque
            if self.ataque > self.relM.ataque:
                self.relM.vida -= dano
                
            elif self.ataque == self.relM.ataque:
                return 'Empate! Ninguém sofreu dano.'
                
            else:
                self.vida -= dano
               
    def defender(self):
        if self.relM.opc == 'atacar':
            if self.relM.ataque >= self.defesa:
                dano = self.relM.ataque - self.defesa
                self.vida -= dano
                self.defesa = 0
            else:
                self.defesa -= self.relM.ataque
                        
        else:
            return 'nada aconteceu'
            
    def fugir(self):
        pass

    def fugir(self):
        chance = random.randint(1, 100)
        if chance <= 80:
            return 'quebrar'
        
        else:
            return 'Você não conseguiu fugir do monstro!'
 
 #             
class Monstro:
    def __init__(self, tmonstro, vida, ataque, defesa, opc = None, relJ = None):
        self.tmonstro = tmonstro
        self.vida = vida
        self.ataque = ataque
        self.defesa = defesa
        self.opc = random.choice(['atacar', 'defender'])
        relJ = relJ

#listas de herois e monstros
herois = {'feiticeira': Heroi('Feiticeira', 100, 20, 30),
          'coronel': Heroi('Coronel', 150, 30, 20),
          'matador': Heroi('Matador', 120, 25, 25),
          'beato': Heroi('Beato', 80, 15, 35),
          'sanfoneiro': Heroi('Sanfoneiro', 90, 20, 30),
          'cangaceiro': Heroi('Cangaceiro', 110, 25, 25)}

monstros = {'caipora': Monstro('Caipora', 80, 25, 15),
            'loira do banheiro': Monstro('Loira do banheiro', 100, 30, 20),
            'cumade florzinha': Monstro('Cumade florzinha', 120, 35, 25),
            'chupa cabra': Monstro('Chupa cabra', 150, 40, 30),
            'rasga mortalha': Monstro('Rasga mortalha', 200, 50, 40),
            'cabra cabriola': Monstro('Cabra cabriola', 250, 60, 50)}

boss = {'iara': Monstro('Iara', 300, 70, 60),
        'boitata': Monstro('Boitata', 350, 80, 70),
        'curupira': Monstro('Curupira', 400, 90, 80),
        'cuca': Monstro('Cuca', 500, 110, 100),
        'corpo seco': Monstro('Corpo seco', 550, 100, 90),
        'fofao': Monstro('Fofão', 600, 120, 110)}

#Textos de batalha
textos = ['', '', '']

#usuario escolher a classe
while True:

    print('Tipos de classes disponiveis:')
    
    print('='*15)
    for i in herois:
        print(f'-- {herois[i].tclasse} --')
    print('='*15)
    
    tclasse = input('Digite a classe do herói: ').lower()
    
    if tclasse in herois:
        jogador = herois[tclasse]
        break
    else:
        print('Tipo de classe inválido')

for t in range(3): #boss e texto
    print(t)
        
    for i in range(3): #inimigos menores e texto deles
        print(i)
        inimigo = random.choice(list(monstros))
        jogador.relM = inimigo
        print(f'Você encontrou um {inimigo}!')
        print(textos[i])

    print(textos[i+t+1]) #Não entendi isso aqui, mas faz sentido
    
    
