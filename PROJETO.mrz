
import random


class Heroi: # Classe pão
    def __init__(self, nome, tClasse, ataque, vida, defesa, inventario=None):
        self.nome = nome
        self.tClasse = tClasse
        self.ataque = ataque
        self.vida = vida
        self.defesa = defesa
        self.inventario = inventario

    def atacar(self, monstro): # isso faz com que o jogador ataque o monstro
        if self.ataque < monstro.defesa:
            print(f"{self.nome} não conseguiu causar dano ao monstro.")
            monstro.defesa -= self.ataque
        elif self.ataque == monstro.defesa:
            monstro.defesa = 0

    def defender(self, monstro): # faz o jogador defender do ataque do monstro
        if monstro.ataque > self.defesa:
            dano = monstro.ataque - self.defesa
            self.vida -= dano
            print(f"{self.nome} recebeu {dano} de dano do monstro.")
        else:
            print(f"{self.nome} conseguiu se defender do ataque do monstro.")

    def usar_item(self, item): #usa um item do inventário
        if item in dicionario_de_itens and item in self.inventario:
            print(f"{self.nome} usou {item}.")
            self.inventario.remove(item)
        else:
            print(f"{self.nome} não possui {item} no inventário.")


class Monstro: # Classe pão
    def __init__(self, nome, vida, ataque, defesa):
        self.nome = nome
        self.vida = vida
        self.ataque = ataque
        self.defesa = defesa

    def atacar(self, jogador): # faz o monstro atacar o jogador
        if self.ataque < jogador.defesa:
            print(f"{self.nome} não conseguiu causar dano ao jogador.")
            jogador.defesa -= self.ataque
        elif self.ataque == jogador.defesa:
            jogador.defesa = 0


while True:

    for i in range(3):
        p1 = Heroi('alanna',random.randint(5,15),100)
p2 = Heroi('Orc',random.randint(5,15),100)

while p1.vida > 0 and p2.vida > 0:

            p1.atacar(p2)
            if p2.vida <= 0:
                break
            print(f'{p1.nome} atacou {p2.nome}.Vida de {p2.nome}:{p2.vida}')
            p2.atacar(p1)
            print(f'{p2.nome} atacou {p1.nome}.Vida de {p1.nome}:{p1.vida}')
            if p1.vida <= 0:
                break

if p1.vida <= 0:
   print(f'{p1.nome} morreu')
else:
   print(f'{p2.nome} morreu')
