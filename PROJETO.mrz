import random
import time
import copy

#Classe Heroi tá com o ataque e defesa show de bolaa
class Heroi:
    
    def __init__(self, tclasse, vida, ataque, defesa, relM = None):
        self.tclasse = tclasse
        self.vida = vida
        self.defesa = defesa
        self.ataque = ataque
        self.relM = relM

    def atacar(self):
        if self.relM.opc == 'defender':
            dano = self.ataque - self.relM.defesa
            if self.ataque >= self.relM.defesa:
                self.relM.vida -= dano
                self.relM.defesa = 0
                print('O monstro tentou defender, mas você foi mais forte!')
                print(f'O monstro {self.relM.tmonstro} sofreu {dano} de dano!')
                print(f'A defesa do monstro {self.relM.tmonstro} agora é {self.relM.defesa}.')
            else:
                self.relM.defesa -= self.ataque
                print(f'O monstro {self.relM.tmonstro} defendeu o ataque! A defesa de {self.relM.tmonstro} agora é {self.relM.defesa}.')
                
        else:
            dano = self.ataque - self.relM.ataque
            if self.ataque > self.relM.ataque:
                self.relM.vida -= dano
                print('O monstro também atacou, mas você foi mais forte!')
                print(f'O monstro {self.relM.tmonstro} sofreu {dano} de dano!')
                
            elif self.ataque == self.relM.ataque:
                print('O monstro também atacou, mas vocês são igualmente fortes!')
                print('Empate! Ninguém sofreu dano.')
                
                
            else:
                dano = self.relM.ataque - self.ataque
                self.vida -= dano
                print('O monstro defendeu o ataque e contra-atacou!')
                print(f'O herói {self.tclasse} sofreu {dano} de dano!')
                
    def defender(self):
        if self.relM.opc == 'atacar':
            if self.relM.ataque >= self.defesa:
                dano = self.relM.ataque - self.defesa
                self.vida -= dano
                self.defesa = 0
                print('O monstro atacou e você tentou defender, mas ele foi mais forte!')
                print(f'O herói {self.tclasse} sofreu {dano} de dano! e agora sua defesa é {self.defesa}')
            else:
                self.defesa -= self.relM.ataque
                print('O monstro atacou e você defendeu com sucesso!')
                print(f'A defesa do herói {self.tclasse} agora é {self.defesa}.')
                        
        else:
            print ('nada aconteceu')
            

    def fugir(self):
        chance = random.randint(1, 100)
        if chance <= 80:
            return 'Você conseguiu fugir do monstro!'
        
        else:
            return 'Você não conseguiu fugir do monstro!'

    def vida(self):
        return f'Vida do {self.tclasse}: {self.vida}'

    def __str__(self):
        return f'''
====================
:--- {self.tclasse} ---: 
vida: {self.vida}
ataque: {self.ataque} 
defesa: {self.defesa}
===================='''


class Armadura:
    
    def __init__(self, nome, porcDefesa, porcAtaque, porcVida):
        self.nome = nome
        self.porcentagem_defesa = porcDefesa
        self.porcentagem_ataque = porcAtaque
        self.porcentagem_vida = porcVida

    def __str__(self):
        return f'Porcentagem de defesa: {self.porcentagem_defesa}\nPorcentagem de ataque: {self.porcentagem_ataque}\nPorcentagem de vida: {self.porcentagem_vida}'

    def dropar(self):
        chance = random.randint(1, 100)
        if chance <= 20:
            return f'Você encontrou a armadura {self.nome}!'
        else:
            return 'Você não encontrou nenhuma armadura.'

#Classe Monstro tá só a carcaça, mas não precisamos de mais nada, só a carcaça mesmo             
class Monstro:
    def __init__(self, tmonstro, vida, ataque, defesa, opc = None):
        self.tmonstro = tmonstro
        self.vida = vida
        self.ataque = ataque
        self.defesa = defesa
        self.opc = random.choice(['atacar', 'defender'])

    def __str__(self):
        return f'-- Vida do monstro: {self.vida} || defesa do monstro: {self.defesa} --'

