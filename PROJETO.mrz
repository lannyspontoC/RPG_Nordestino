            print(f"{self.nome} usou {item}.")
            self.inventario.remove(item)
        else:
            print(f"{self.nome} não possui {item} no inventário.")


class Monstro: # Classe pão
    def __init__(self, nome, vida, ataque, defesa):
        self.nome = nome
        self.vida = vida
        self.ataque = ataque
        self.defesa = defesa

    def atacar(self, jogador): # faz o monstro atacar o jogador
        if self.ataque < jogador.defesa:
            print(f"{self.nome} não conseguiu causar dano ao jogador.")
            jogador.defesa -= self.ataque
        elif self.ataque == jogador.defesa:
            jogador.defesa = 0


